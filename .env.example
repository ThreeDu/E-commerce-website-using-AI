# ─── LLM Multi-Provider Config ───
CHATBOT_LLM_PROVIDERS=
CHATBOT_LLM_TIMEOUT_MS=

# Provider: local (LM Studio / Ollama)
CHATBOT_LLM_LOCAL_URL=
CHATBOT_LLM_LOCAL_KEY=
CHATBOT_LLM_LOCAL_MODEL=

# Provider: gemini (Google AI Cloud)
CHATBOT_LLM_GEMINI_URL=
CHATBOT_LLM_GEMINI_KEY=
CHATBOT_LLM_GEMINI_MODEL=

# Legacy Single-Provider Fallback Config
CHATBOT_LLM_API_URL=
CHATBOT_LLM_API_KEY=
CHATBOT_LLM_MODEL=

# ─── Embedding Config (RAG Vector Search) ───
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ─── Database (Cloud Firestore) ───
# Local: đường dẫn tới file key service account (không commit file này)
GOOGLE_APPLICATION_CREDENTIALS=server/<ten-file-firebase-adminsdk>.json
# Vercel: dán toàn bộ nội dung JSON của key vào một dòng
FIREBASE_SERVICE_ACCOUNT=
# Chạy với Firestore Emulator (npx firebase-tools emulators:start --only firestore)
FIRESTORE_EMULATOR_HOST=
# Chỉ dùng cho script server/scripts/migrate_mongo_to_firestore.js
MONGO_URI=

# ─── Authentication ───
JWT_SECRET=

# ─── BeePay Config ───
BEEPAY_SITE_TOKEN=
BEEPAY_HMAC_SECRET=
BEEPAY_API_KEY=
BEEPAY_PREFIX=

# ─── Bank Account (Sinh mã VietQR) ───
BANK_ID=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
# ML service (ml-service/)
ML_SERVICE_URL=http://localhost:5001
# Khóa dùng chung Node <-> ml-service (header X-ML-Key); bắt buộc khi ml-service chạy trên Vercel, đặt giống nhau ở cả 2 project.
ML_API_KEY=
